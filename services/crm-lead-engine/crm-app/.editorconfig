root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,js,css,html,md,yml,yaml,ps1}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.csproj]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
