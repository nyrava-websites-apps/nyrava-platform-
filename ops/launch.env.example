# PLACEHOLDERS ONLY. Copy into a private, untracked server env file when ready.
# Existing Stripe products/prices are never created or modified by this repair.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# Same random value (at least 32 characters) on web-portal and crm-lead-engine.
# Generate locally on the server; never commit the real value.
