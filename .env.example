# ===================================================================
# NYRAVA UNIFIED PLATFORM CONFIGURATION (BLUE PRODUCTION ARCHITECTURE)
# ===================================================================

# Production Domains (Subdomains or Custom Domains)
PORTAL_DOMAIN=home.nyrava.com
CRM_DOMAIN=crm.nyrava.com
VALUATION_DOMAIN=value.nyrava.com
MEET_DOMAIN=meet.nyrava.com

# Service Ports (If running without Docker or behind custom proxy)
PORTAL_PORT=3000
CRM_PORT=5180
VALUATION_PORT=5190
MEET_PORT=5000

# Centralized Outgoing Email Service (Zoho SMTP for Nyrava Home)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=notifications@nyrava.com
SMTP_PASS=your-zoho-application-specific-password
EMAIL_FROM=Nyrava Home <notifications@nyrava.com>
SMTP_SSL=true

# PostgreSQL Database (System of Record)
POSTGRES_DB=nyrava_crm
POSTGRES_USER=nyrava_admin
POSTGRES_PASSWORD=NyravaSecurePg2026!
POSTGRES_PORT=5432

# Redis Cache, Sessions & Presence
REDIS_PASSWORD=NyravaRedisSecure2026!
REDIS_PORT=6379

# JWT Central Identity Secret (Min 32 characters)
JWT_SECRET=NyravaHome_Production_JwtSigningKey_Secure_2026_Minimum32Bytes!

# NATS Event Bus
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# Coturn STUN/TURN WebRTC Relay
TURN_PORT=3478
TURN_USER=nyrava_user
TURN_PASS=turn_secure_pass_2026

# MinIO Object Storage & Backups
MINIO_ROOT_USER=nyrava_minio
MINIO_ROOT_PASSWORD=NyravaMinioSecret2026!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
