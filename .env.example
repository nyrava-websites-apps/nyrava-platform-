# ===================================================================
# NYRAVA UNIFIED PLATFORM CONFIGURATION
# ===================================================================

# Production Domains (Subdomains or Custom Domains)
# Example:
# PORTAL_DOMAIN=home.nyrava.com (or preview.nyrava.com)
# CRM_DOMAIN=crm.nyrava.com
# VALUATION_DOMAIN=value.nyrava.com
# MEET_DOMAIN=meet.nyrava.com
PORTAL_DOMAIN=localhost
CRM_DOMAIN=crm.localhost
VALUATION_DOMAIN=value.localhost
MEET_DOMAIN=meet.localhost

# Service Ports (If running without Docker or behind custom proxy)
PORTAL_PORT=3000
CRM_PORT=5180
VALUATION_PORT=5190
MEET_PORT=5000

# Automated Valuation Email Service (SMTP)
# Leave blank to use local file-outbox logging
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key-here
EMAIL_FROM=Nyrava Home <evaluations@nyrava.com>
