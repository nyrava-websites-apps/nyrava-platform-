{
    email admin@nyrava.com
}

# ===================================================================
# NYRAVA HOME — PRODUCTION HARDENED CADDY REVERSE PROXY & WAF
# Blue Architecture: Edge TLS, Security Headers, WAF, Rate Limiting
# ===================================================================

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=*, microphone=*, display-capture=*, fullscreen=*"
        -Server
    }
}

(waf_rules) {
    # Block sensitive paths, environment files, git, backups, and SQL dumps
    @blocked_paths {
        path */.*
        path *.env*
        path *.git*
        path *.sql*
        path *.bak*
        path */wp-admin*
        path */xmlrpc.php*
        path */.vscode*
    }
    respond @blocked_paths 403

    # Limit maximum body size to protect against buffer overflow / DOS
    request_body {
        max_size 25MB
    }
}

# 1. Main Web Portal (home.nyrava.com)
http://{$PORTAL_DOMAIN:home.nyrava.com}, https://{$PORTAL_DOMAIN:home.nyrava.com} {
    import security_headers
    import waf_rules

    reverse_proxy web-portal:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    encode gzip zstd
}

# 2. Realtor CRM & Lead Engine (crm.nyrava.com)
http://{$CRM_DOMAIN:crm.nyrava.com}, https://{$CRM_DOMAIN:crm.nyrava.com} {
    import security_headers
    import waf_rules

    reverse_proxy crm-lead-engine:5180 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
